# Copia este archivo a .env antes de levantar la pila:
#
#   cp .env.example .env
#
# .env no se versiona. Cambia los valores marcados como placeholder: este
# archivo no contiene credenciales reales.

POSTGRES_USER=hta
POSTGRES_PASSWORD=cambiar-en-produccion
POSTGRES_DB=hta

# Puertos publicados en el host. Los valores de omisión son los del compose;
# descomenta una línea para cambiarlo.
# BACKEND_PORT=8000
# WEB_PORT=3000
# POSTGRES_PORT=5432
# MONGO_PORT=27017

# El secreto de abajo es el placeholder público: el backend lo rechaza al
# arrancar. Genera el real con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
HTA_JWT_SECRET=cambiar-en-produccion
HTA_ACCESS_TTL_SECONDS=900
HTA_REFRESH_TTL_SECONDS=604800
HTA_ENVIRONMENT=local

# Orígenes que el navegador puede llamar, separados por comas. Si se deja vacío,
# la API permite los puertos de desarrollo de la interfaz web: 5173 (Vite) y
# 3000 (servidor de ejemplo).
HTA_ALLOWED_ORIGINS=

# Clave compartida que los dispositivos envían en X-Device-Key. El valor de
# ejemplo es el mismo que usan las pruebas y solo sirve para la pila local:
# cámbialo antes de desplegar en un host compartido. Si se deja vacío, la ruta
# de ingesta responde 503 y no acepta escrituras. No es la sesión de una
# persona: es el secreto del adaptador de dispositivo y no debe llegar al
# navegador. Genera uno con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HTA_DEVICE_KEY=clave-de-prueba
