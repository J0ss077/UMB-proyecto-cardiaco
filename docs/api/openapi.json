{
  "components": {
    "schemas": {
      "AcceptRequest": {
        "description": "Versión y referencia del documento que el paciente acepta.",
        "properties": {
          "content_ref": {
            "title": "Content Ref",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "content_ref"
        ],
        "title": "AcceptRequest",
        "type": "object"
      },
      "AcceptedConsent": {
        "description": "Identificador de la aceptación recién registrada.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "AcceptedConsent",
        "type": "object"
      },
      "AccountSummary": {
        "description": "Datos de una cuenta que ve quien administra el sistema.",
        "properties": {
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "full_name",
          "role",
          "active"
        ],
        "title": "AccountSummary",
        "type": "object"
      },
      "ConsentStatus": {
        "description": "Estado del consentimiento para la versión que consulta el cliente.\n\n``requires_acceptance_of_version`` es ``None`` cuando el consentimiento\nestá vigente y, cuando no lo está, la versión cuya aceptación falta. Así el\ncliente no tiene que comparar versiones por su cuenta para saber qué\ndocumento debe presentar.",
        "properties": {
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "requires_acceptance_of_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requires Acceptance Of Version"
          }
        },
        "required": [
          "active",
          "requires_acceptance_of_version"
        ],
        "title": "ConsentStatus",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Estado del servicio y de cada dependencia, con los nombres del contrato.",
        "properties": {
          "database": {
            "title": "Database",
            "type": "string"
          },
          "mongo": {
            "title": "Mongo",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database",
          "mongo"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LoginRequest": {
        "description": "Credenciales que envía el cliente al iniciar sesión.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "PaginatedAccounts": {
        "description": "Envoltura de los listados: la página de cuentas y el total de filas.\n\nEs la forma que el contrato fija para todo listado: ``items`` lleva los\nelementos y ``total`` las filas que existen, para que el cliente sepa\ncuántas páginas faltan sin pedir una de más.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AccountSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "title": "PaginatedAccounts",
        "type": "object"
      },
      "RefreshRequest": {
        "description": "Token de refresco que el cliente presenta para rotarlo o revocarlo.",
        "properties": {
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest",
        "type": "object"
      },
      "RegisterRequest": {
        "additionalProperties": false,
        "description": "Datos del registro público de un paciente.\n\nEl modelo no declara ``role`` y rechaza los campos desconocidos: un cliente\nno puede elegir el rol de la cuenta que crea. El rol lo fija el servicio.",
        "properties": {
          "birth_date": {
            "format": "date",
            "title": "Birth Date",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "full_name",
          "birth_date"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "RegisteredAccount": {
        "description": "Identificador de la cuenta recién creada.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "RegisteredAccount",
        "type": "object"
      },
      "RoleRequest": {
        "description": "Rol nuevo que se aplica a una cuenta.",
        "properties": {
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role"
        ],
        "title": "RoleRequest",
        "type": "object"
      },
      "TokenPair": {
        "description": "Par de tokens de la sesión y el rol de la cuenta autenticada.\n\nEs el cuerpo de respuesta del inicio y de la rotación. ``refresh_token``\nsolo se entrega aquí: no se puede reconstruir a partir de su huella.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "role"
        ],
        "title": "TokenPair",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Plataforma HTA",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/accounts": {
      "get": {
        "description": "Lista las cuentas ordenadas por correo; solo para administradores.\n\nDevuelve una página de la envoltura del contrato. ``total`` cuenta todas las\nfilas de ``users`` antes de recortar la página, de modo que el cliente sepa\ncuántas faltan; ``limit`` y ``offset`` se aplican en la consulta y no en\nmemoria.",
        "operationId": "list_accounts_api_accounts_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 0,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedAccounts"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Accounts",
        "tags": [
          "accounts"
        ]
      }
    },
    "/api/accounts/register": {
      "post": {
        "description": "Crea una cuenta de paciente y su perfil a partir del cuerpo recibido.",
        "operationId": "register_api_accounts_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisteredAccount"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register",
        "tags": [
          "accounts"
        ]
      }
    },
    "/api/accounts/{user_id}/deactivate": {
      "post": {
        "description": "Seudonimiza la cuenta indicada sin borrar su historial clínico.",
        "operationId": "deactivate_api_accounts__user_id__deactivate_post",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "User Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Deactivate",
        "tags": [
          "accounts"
        ]
      }
    },
    "/api/accounts/{user_id}/role": {
      "patch": {
        "description": "Cambia el rol de la cuenta indicada; solo un administrador puede hacerlo.",
        "operationId": "change_role_api_accounts__user_id__role_patch",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "User Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Change Role",
        "tags": [
          "accounts"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "description": "Inicia la sesión y entrega el par de tokens con el rol de la cuenta.",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "description": "Cierra la sesión revocando el token de refresco recibido.",
        "operationId": "logout_api_auth_logout_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/refresh": {
      "post": {
        "description": "Rota el refresco y entrega un par nuevo, invalidando el presentado.",
        "operationId": "refresh_api_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Refresh",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/consent": {
      "get": {
        "description": "Informa si el paciente tiene consentimiento vigente para una versión.",
        "operationId": "read_status_api_consent_get",
        "parameters": [
          {
            "in": "query",
            "name": "required_version",
            "required": false,
            "schema": {
              "default": 1,
              "title": "Required Version",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Status",
        "tags": [
          "consent"
        ]
      },
      "post": {
        "description": "Registra una aceptación nueva del documento firmada por el paciente.",
        "operationId": "accept_api_consent_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedConsent"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Accept",
        "tags": [
          "consent"
        ]
      }
    },
    "/api/consent/revoke": {
      "post": {
        "description": "Revoca las aceptaciones vigentes del paciente y conserva el historial.",
        "operationId": "revoke_api_consent_revoke_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Revoke",
        "tags": [
          "consent"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Informa el estado de cada dependencia sin lanzar excepción.\n\nResponde 200 aunque una dependencia falle: el cuerpo distingue la\ndependencia degradada y el campo ``status`` queda en ``degraded``.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
