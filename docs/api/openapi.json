    "/api/readings": {
      "get": {
        "description": "Lista las lecturas del paciente visible, de la más reciente a la más vieja.\n\nSin ``patient_id`` el paciente ve sus propias lecturas; el médico y el\ncuidador deben indicar uno y la resolución comprueba el vínculo. ``since``\ny ``until`` son opcionales, inclusivos y deben ser ISO 8601 con\ndesplazamiento horario. No se exige consentimiento: es la historia clínica.",
        "operationId": "list_readings_api_readings_get",
        "parameters": [
          {
            "in": "query",
            "name": "patient_id",
            "required": false,
            "schema": {
